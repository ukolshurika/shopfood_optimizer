# Qwen via Yandex AI Studio OpenAI-compatible API
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_QWEN_MODEL=gpt://<folder_ID>/qwen3.6-35b-a3b
YANDEX_QWEN_STRONG_MODEL=gpt://<folder_ID>/<stronger-qwen-model>
YANDEXGPT_LITE_MODEL=gpt://<folder_ID>/yandexgpt-5-lite
YANDEXGPT_PRO_MODEL=gpt://<folder_ID>/yandexgpt-5-pro

# GigaChat Freemium, personal non-commercial use only
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_BASE_URL=https://api.giga.chat/v1
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_VERIFY_SSL=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_RESPONSE_MODE=json_object

# OpenAI control
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Benchmark
BENCHMARK_CONCURRENCY=3
BENCHMARK_TIMEOUT_SECONDS=60
BENCHMARK_NETWORK_RETRIES=2
BENCHMARK_SCHEMA_RETRIES=1
